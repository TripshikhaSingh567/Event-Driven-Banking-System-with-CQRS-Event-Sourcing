{
  "info": {
    "_postman_id": "banking-system-cqrs-collection",
    "name": "Banking System - CQRS & Event Sourcing",
    "description": "Postman collection for the Banking System project implementing CQRS, Event Sourcing and Axon Framework.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "sourceAccountId",
      "value": ""
    },
    {
      "key": "destinationAccountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Account Commands",
      "item": [
        {
          "name": "1. Open Source Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test User 1\",\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const match = pm.response.text().match(/Account ID:\\s*([a-f0-9-]{36})/i);",
                  "pm.test('Account ID is returned', function () { pm.expect(match).to.not.be.null; });",
                  "if (match) { pm.collectionVariables.set('sourceAccountId', match[1]); pm.collectionVariables.set('accountId', match[1]); }"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Deposit Money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}",
                "deposit"
              ]
            }
          }
        },
        {
          "name": "3. Withdraw Money",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}/withdraw",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}",
                "withdraw"
              ]
            }
          }
        },
        {
          "name": "4. Open Destination Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test User 2\",\n  \"accountType\": \"SAVINGS\",\n  \"initialBalance\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const match = pm.response.text().match(/Account ID:\\s*([a-f0-9-]{36})/i);",
                  "pm.test('Destination Account ID is returned', function () { pm.expect(match).to.not.be.null; });",
                  "if (match) pm.collectionVariables.set('destinationAccountId', match[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Transfer Money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinationAccountId\": \"{{destinationAccountId}}\",\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}",
                "transfer"
              ]
            }
          }
        },
        {
          "name": "6. Close Source Account",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}/close",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}",
                "close"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Queries",
      "item": [
        {
          "name": "7. Get All Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            }
          }
        },
        {
          "name": "8. Get Source Account By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}"
              ]
            }
          }
        },
        {
          "name": "9. Get Destination Account By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{destinationAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{destinationAccountId}}"
              ]
            }
          }
        },
        {
          "name": "10. Get Source Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{sourceAccountId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{sourceAccountId}}",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "11. Get Destination Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{destinationAccountId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts",
                "{{destinationAccountId}}",
                "transactions"
              ]
            }
          }
        }
      ]
    }
  ]
}